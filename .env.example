# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icu_command?schema=public"

# Authentication (NextAuth / Auth.js)
NEXTAUTH_SECRET="icu-command-secure-production-secret-key-2026-demo"
NEXTAUTH_URL="http://localhost:3000"

# AI Speech & LLM Configuration
# AI_PROVIDER can be 'groq' (default), 'openai', or 'gemini'
AI_PROVIDER="groq"
AI_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"
AI_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"

# WhatsApp Provider Configuration
# WHATSAPP_PROVIDER can be 'mock' (default) or 'meta'
WHATSAPP_PROVIDER="mock"

# Escalation Configuration
ESCALATION_REMINDER_MINUTES="15"
ESCALATION_SECOND_REMINDER_MINUTES="30"
ESCALATION_CONSULTANT_MINUTES="45"
CRON_SECRET="demo-cron-secret-2026"

# Demo Mode Enabled (permits simulated actions & fallback task extraction)
DEMO_MODE="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
